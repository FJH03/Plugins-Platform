{
    "name": "css",
    "env_var": "HL2SDKCSS",
    "extension": "2.css",
    "code": 6,
    "define": "CSS",
    "steam": {
        "app_id": 232330
    },
    "platforms": {
        "windows": [
            "x86_64"
        ],
        "linux": [
            "x86_64"
        ]
    },
    "source2": false,
    "include_paths": [
        "source-engine-czero/public",
        "source-engine-czero/public/engine",
        "source-engine-czero/public/mathlib",
        "source-engine-czero/public/vstdlib",
        "source-engine-czero/public/tier0",
        "source-engine-czero/public/tier1",
        "source-engine-czero/public/toolframework",
        "source-engine-czero/public/game/server",
        "source-engine-czero/game/server",
        "source-engine-czero/game/shared",
        "source-engine-czero/common"
    ],
    "linux": {
        "defines": [
            "NO_HOOK_MALLOC",
            "NO_MALLOC_OVERRIDE",
            "CSTRIKE_DLL"
        ],
        "cflags": [
            "-Wno-overloaded-virtual",
            "-Wno-unused-function",
            "-Wno-unknown-pragmas",
            "-Wno-dangling-else",
            "-Wno-unused-variable",
            "-Wno-unused-private-field",
            "-Wno-inconsistent-missing-override",
            "-Wno-tautological-overlap-compare",
            "-Wno-tautological-constant-out-of-range-compare",
            "-Wno-undefined-bool-conversion",
            "-fPIC"
        ],
        "x86_64": {
            "cflags": ["-march=nocona", "-march=core2"],
            "dynamic_libs": [
                "source-engine-czero/lib/public/linux64/libtier0_srv.so",
                "source-engine-czero/lib/public/linux64/libvstdlib_srv.so"
            ]
        },
        "uses_system_cxxlib": false
    },
    "windows": {
        "defines": [
            "CSTRIKE_DLL",
            "MEMHELPERS_H"
        ],
        "x86_64": {
            "libs": [
                "source-engine-czero/build/tier0/tier0.lib",
                "source-engine-czero/build/vstdlib/vstdlib.lib",
                "source-engine-czero/build/mathlib/mathlib.lib",
                "source-engine-czero/build/tier1/tier1.lib"
            ]
        }
    }
}